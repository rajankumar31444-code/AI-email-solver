 {  "name": "ai-email-assistant",  "version": "1.0.0",  "description": "AI-Powered Email Management Assistant",  "main": "server.js",  "type": "module",  "scripts": {    "start": "node server.js"  },  "dependencies": {    "@google/genai": "^0.1.1",    "cors": "^2.8.5",    "dotenv": "^16.4.5",    "express": "^4.19.2"  }}PORT=3000GEMINI_API_KEY=your_gemini_api_key_hereimport express from 'express';import cors from 'cors';import dotenv from 'dotenv';import { GoogleGenAI, Type } from '@google/genai';dotenv.config();const app = express();app.use(cors());app.use(express.json());app.use(express.static('public'));const ai = new GoogleGenAI({ apiKey: process.env.GEMINI_API_KEY });// System Instruction for structured output engineeringconst SYSTEM_INSTRUCTION = `You are an expert AI Email Assistant. Analyze incoming emails thoroughly and extract standard metadata, actionable insights, safety assessments, and suggested responses.Always strictly follow the JSON response schema.`;const emailAnalysisSchema = {  type: Type.OBJECT,  properties: {    summary: {      type: Type.STRING,      description: "A concise 1-2 sentence summary of the core email content."    },    priority: {      type: Type.STRING,      enum: ["High", "Medium", "Low"],      description: "Priority level calculated based on urgency, deadlines, and sender context."    },    category: {      type: Type.STRING,      description: "Work, Personal, Finance, Marketing, Urgent, Meeting, Support, etc."    },    sentiment: {      type: Type.STRING,      enum: ["Positive", "Neutral", "Negative", "Urgent/Frustrated"]    },    isSpamOrPhishing: {      type: Type.BOOLEAN,      description: "True if email contains suspicious links, phishing tactics, or spam characteristics."    },    spamReasoning: {      type: Type.STRING,      description: "Explanation if flagged as spam/phishing, otherwise empty string."    },    detectedLanguage: {      type: Type.STRING,      description: "Primary language of the email (e.g., English, Spanish, Hindi)."    },    tasks: {      type: Type.ARRAY,      items: {        type: Type.OBJECT,        properties: {          task: { type: Type.STRING },          deadline: { type: Type.STRING, description: "Extracted deadline date/time or 'None'" }        },        required: ["task", "deadline"]      }    },    calendarEvents: {      type: Type.ARRAY,      items: {        type: Type.OBJECT,        properties: {          title: { type: Type.STRING },          dateTime: { type: Type.STRING, description: "Date and time of meeting/event" },          locationOrLink: { type: Type.STRING }        },        required: ["title", "dateTime"]      }    },    smartReplies: {      type: Type.OBJECT,      properties: {        formal: { type: Type.STRING, description: "Professional response" },        casual: { type: Type.STRING, description: "Friendly tone response" },        decline: { type: Type.STRING, description: "Polite refusal or deferral" }      },      required: ["formal", "casual", "decline"]    },    followUpReminder: {      type: Type.STRING,      description: "Suggested follow-up reminder timeframe (e.g., 'Remind in 2 days if no reply')."    }  },  required: [    "summary", "priority", "category", "sentiment", "isSpamOrPhishing",    "spamReasoning", "detectedLanguage", "tasks", "calendarEvents",    "smartReplies", "followUpReminder"  ]};app.post('/api/analyze-email', async (req, res) => {  try {    const { sender, subject, body } = req.body;    if (!body) {      return res.status(400).json({ error: "Email body content is required." });    }    const prompt = `Analyze the following incoming email:Sender: ${sender || 'Unknown'}Subject: ${subject || 'No Subject'}Body:${body}`;    const response = await ai.models.generateContent({      model: 'gemini-2.5-flash',      contents: prompt,      config: {        systemInstruction: SYSTEM_INSTRUCTION,        responseMimeType: 'application/json',        responseSchema: emailAnalysisSchema,        temperature: 0.2      }    });    const analysisResult = JSON.parse(response.text);    res.json({ success: true, data: analysisResult });  } catch (error) {    console.error("Analysis Error:", error);    res.status(500).json({ success: false, error: "Failed to analyze email." });  }});const PORT = process.env.PORT || 3000;app.listen(PORT, () => {  console.log(`Server running on http://localhost:${PORT}`);});import express from 'express';import cors from 'cors';import dotenv from 'dotenv';import { GoogleGenAI, Type } from '@google/genai';dotenv.config();const app = express();app.use(cors());app.use(express.json());app.use(express.static('public'));const ai = new GoogleGenAI({ apiKey: process.env.GEMINI_API_KEY });// System Instruction for structured output engineeringconst SYSTEM_INSTRUCTION = `You are an expert AI Email Assistant. Analyze incoming emails thoroughly and extract standard metadata, actionable insights, safety assessments, and suggested responses.Always strictly follow the JSON response schema.`;const emailAnalysisSchema = {  type: Type.OBJECT,  properties: {    summary: {      type: Type.STRING,      description: "A concise 1-2 sentence summary of the core email content."    },    priority: {      type: Type.STRING,      enum: ["High", "Medium", "Low"],      description: "Priority level calculated based on urgency, deadlines, and sender context."    },    category: {      type: Type.STRING,      description: "Work, Personal, Finance, Marketing, Urgent, Meeting, Support, etc."    },    sentiment: {      type: Type.STRING,      enum: ["Positive", "Neutral", "Negative", "Urgent/Frustrated"]    },    isSpamOrPhishing: {      type: Type.BOOLEAN,      description: "True if email contains suspicious links, phishing tactics, or spam characteristics."    },    spamReasoning: {      type: Type.STRING,      description: "Explanation if flagged as spam/phishing, otherwise empty string."    },    detectedLanguage: {      type: Type.STRING,      description: "Primary language of the email (e.g., English, Spanish, Hindi)."    },    tasks: {      type: Type.ARRAY,      items: {        type: Type.OBJECT,        properties: {          task: { type: Type.STRING },          deadline: { type: Type.STRING, description: "Extracted deadline date/time or 'None'" }        },        required: ["task", "deadline"]      }    },    calendarEvents: {      type: Type.ARRAY,      items: {        type: Type.OBJECT,        properties: {          title: { type: Type.STRING },          dateTime: { type: Type.STRING, description: "Date and time of meeting/event" },          locationOrLink: { type: Type.STRING }        },        required: ["title", "dateTime"]      }    },    smartReplies: {      type: Type.OBJECT,      properties: {        formal: { type: Type.STRING, description: "Professional response" },        casual: { type: Type.STRING, description: "Friendly tone response" },        decline: { type: Type.STRING, description: "Polite refusal or deferral" }      },      required: ["formal", "casual", "decline"]    },    followUpReminder: {      type: Type.STRING,      description: "Suggested follow-up reminder timeframe (e.g., 'Remind in 2 days if no reply')."    }  },  required: [    "summary", "priority", "category", "sentiment", "isSpamOrPhishing",    "spamReasoning", "detectedLanguage", "tasks", "calendarEvents",    "smartReplies", "followUpReminder"  ]};app.post('/api/analyze-email', async (req, res) => {  try {    const { sender, subject, body } = req.body;    if (!body) {      return res.status(400).json({ error: "Email body content is required." });    }    const prompt = `Analyze the following incoming email:Sender: ${sender || 'Unknown'}Subject: ${subject || 'No Subject'}Body:${body}`;    const response = await ai.models.generateContent({      model: 'gemini-2.5-flash',      contents: prompt,      config: {        systemInstruction: SYSTEM_INSTRUCTION,        responseMimeType: 'application/json',        responseSchema: emailAnalysisSchema,        temperature: 0.2      }    });    const analysisResult = JSON.parse(response.text);    res.json({ success: true, data: analysisResult });  } catch (error) {    console.error("Analysis Error:", error);    res.status(500).json({ success: false, error: "Failed to analyze email." });  }});const PORT = process.env.PORT || 3000;app.listen(PORT, () => {  console.log(`Server running on http://localhost:${PORT}`);})import cors from 'cors';import dotenv from 'dotenv';import { GoogleGenAI, Type } from '@google/genai';dotenv.config();const app = express();app.use(cors());app.use(express.json());app.use(express.static('public'));const ai = new GoogleGenAI({ apiKey: process.env.GEMINI_API_KEY });// System Instruction for structured output engineeringconst SYSTEM_INSTRUCTION = `You are an expert AI Email Assistant. Analyze incoming emails thoroughly and extract standard metadata, actionable insights, safety assessments, and suggested responses.Always strictly follow the JSON response schema.`;const emailAnalysisSchema = {  type: Type.OBJECT,  properties: {    summary: {      type: Type.STRING,      description: "A concise 1-2 sentence summary of the core email content."    },    priority: {      type: Type.STRING,      enum: ["High", "Medium", "Low"],      description: "Priority level calculated based on urgency, deadlines, and sender context."    },    category: {      type: Type.STRING,      description: "Work, Personal, Finance, Marketing, Urgent, Meeting, Support, etc."    },    sentiment: {      type: Type.STRING,      enum: ["Positive", "Neutral", "Negative", "Urgent/Frustrated"]    },    isSpamOrPhishing: {      type: Type.BOOLEAN,      description: "True if email contains suspicious links, phishing tactics, or spam characteristics."    },    spamReasoning: {      type: Type.STRING,      description: "Explanation if flagged as spam/phishing, otherwise empty string."    },    detectedLanguage: {      type: Type.STRING,      description: "Primary language of the email (e.g., English, Spanish, Hindi)."    },    tasks: {      type: Type.ARRAY,      items: {        type: Type.OBJECT,        properties: {          task: { type: Type.STRING },          deadline: { type: Type.STRING, description: "Extracted deadline date/time or 'None'" }        },        required: ["task", "deadline"]      }    },    calendarEvents: {      type: Type.ARRAY,      items: {        type: Type.OBJECT,        properties: {          title: { type: Type.STRING },          dateTime: { type: Type.STRING, description: "Date and time of meeting/event" },          locationOrLink: { type: Type.STRING }        },        required: ["title", "dateTime"]      }    },    smartReplies: {      type: Type.OBJECT,      properties: {        formal: { type: Type.STRING, description: "Professional response" },        casual: { type: Type.STRING, description: "Friendly tone response" },        decline: { type: Type.STRING, description: "Polite refusal or deferral" }      },      required: ["formal", "casual", "decline"]    },    followUpReminder: {      type: Type.STRING,      description: "Suggested follow-up reminder timeframe (e.g., 'Remind in 2 days if no reply')."    }  },  required: [    "summary", "priority", "category", "sentiment", "isSpamOrPhishing",    "spamReasoning", "detectedLanguage", "tasks", "calendarEvents",    "smartReplies", "followUpReminder"  ]};app.post('/api/analyze-email', async (req, res) => {  try {    const { sender, subject, body } = req.body;    if (!body) {      return res.status(400).json({ error: "Email body content is required." });    }    const prompt = `Analyze the following incoming email:Sender: ${sender || 'Unknown'}Subject: ${subject || 'No Subject'}Body:${body}`;    const response = await ai.models.generateContent({      model: 'gemini-2.5-flash',      contents: prompt,      config: {        systemInstruction: SYSTEM_INSTRUCTION,        responseMimeType: 'application/json',        responseSchema: emailAnalysisSchema,        temperature: 0.2      }    });    const analysisResult = JSON.parse(response.text);    res.json({ success: true, data: analysisResult });  } catch (error) {    console.error("Analysis Error:", error);    res.status(500).json({ success: false, error: "Failed to analyze email." });  }});const PORT = process.env.PORT || 3000;app.listen(PORT, () => {  console.log(`Server running on http://localhost:${PORT}`);}); 